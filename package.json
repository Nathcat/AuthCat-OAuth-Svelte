{
  "name": "authcat-oauth-svelte",
  "version": "0.0.3",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./OauthButton.svelte": {
      "types": "./dist/OauthButton.svelte.d.ts",
      "svelte": "./dist/OauthButton.svelte"
    },
    "./Profilepicture.svelte": {
      "types": "./dist/Profilepicture.svelte.d.ts",
      "svelte": "./dist/Profilepicture.svelte"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "publint": "^0.3.24",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "keywords": [
    "svelte"
  ],
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "uuid": "^14.0.2"
  },
  "publishConfig": {
    "registry": "https://npm.nathcat.net/"
  }
}
